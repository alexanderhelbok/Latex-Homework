@article{obrien_optical_2007,
	title = {Optical Quantum Computing},
	volume = {318},
	issn = {0036-8075, 1095-9203},
	url = {http://arxiv.org/abs/0803.1554},
	doi = {10.1126/science.1142892},
	abstract = {In 2001 all-optical quantum computing became feasible with the discovery that scalable quantum computing is possible using only single photon sources, linear optical elements, and single photon detectors. Although it was in principle scalable, the massive resource overhead made the scheme practically daunting. However, several simplifications were followed by proof-of-principle demonstrations, and recent approaches based on cluster states or error encoding have dramatically reduced this worrying resource overhead, making an all-optical architecture a serious contender for the ultimate goal of a large-scale quantum computer. Key challenges will be the realization of high-efficiency sources of indistinguishable single photons, low-loss, scalable optical circuits, high efficiency single photon detectors, and low-loss interfacing of these components.},
	pages = {1567--1570},
	number = {5856},
	journaltitle = {Science},
	shortjournal = {Science},
	author = {O'Brien, Jeremy L.},
	urldate = {2025-03-18},
	date = {2007-12-07},
	eprinttype = {arxiv},
	eprint = {0803.1554 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Preprint PDF:/home/taco/Zotero/storage/THXWTU8F/O'Brien - 2007 - Optical Quantum Computing.pdf:application/pdf;Snapshot:/home/taco/Zotero/storage/7M7VCNNS/0803.html:text/html},
}

@article{ladd_quantum_2010,
	title = {Quantum Computing},
	volume = {464},
	issn = {0028-0836, 1476-4687},
	url = {http://arxiv.org/abs/1009.2267},
	doi = {10.1038/nature08812},
	abstract = {Quantum mechanics---the theory describing the fundamental workings of nature---is famously counterintuitive: it predicts that a particle can be in two places at the same time, and that two remote particles can be inextricably and instantaneously linked. These predictions have been the topic of intense metaphysical debate ever since the theory's inception early last century. However, supreme predictive power combined with direct experimental observation of some of these unusual phenomena leave little doubt as to its fundamental correctness. In fact, without quantum mechanics we could not explain the workings of a laser, nor indeed how a fridge magnet operates. Over the last several decades quantum information science has emerged to seek answers to the question: can we gain some advantage by storing, transmitting and processing information encoded in systems that exhibit these unique quantum properties? Today it is understood that the answer is yes. Many research groups around the world are working towards one of the most ambitious goals humankind has ever embarked upon: a quantum computer that promises to exponentially improve computational power for particular tasks. A number of physical systems, spanning much of modern physics, are being developed for this task---ranging from single particles of light to superconducting circuits---and it is not yet clear which, if any, will ultimately prove successful. Here we describe the latest developments for each of the leading approaches and explain what the major challenges are for the future.},
	pages = {45--53},
	number = {7285},
	journaltitle = {Nature},
	shortjournal = {Nature},
	author = {Ladd, Thaddeus D. and Jelezko, Fedor and Laflamme, Raymond and Nakamura, Yasunobu and Monroe, Christopher and O'Brien, Jeremy L.},
	urldate = {2025-03-18},
	date = {2010-03},
	eprinttype = {arxiv},
	eprint = {1009.2267 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Preprint PDF:/home/taco/Zotero/storage/I3S7GFDL/Ladd et al. - 2010 - Quantum Computing.pdf:application/pdf;Snapshot:/home/taco/Zotero/storage/EZW3HBDJ/1009.html:text/html},
}


@article{monroe_scaling_2013,
	title = {Scaling the Ion Trap Quantum Processor},
	volume = {339},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.1231298},
	doi = {10.1126/science.1231298},
	abstract = {Trapped atomic ions are standards for quantum information processing, serving as quantum memories, hosts of quantum gates in quantum computers and simulators, and nodes of quantum communication networks. Quantum bits based on trapped ions enjoy a rare combination of attributes: They have exquisite coherence properties, they can be prepared and measured with nearly 100\% efficiency, and they are readily entangled with each other through the Coulomb interaction or remote photonic interconnects. The outstanding challenge is the scaling of trapped ions to hundreds or thousands of qubits and beyond, at which scale quantum processors can outperform their classical counterparts in certain applications. We review the latest progress and prospects in that effort, with the promise of advanced architectures and new technologies, such as microfabricated ion traps and integrated photonics.},
	pages = {1164--1169},
	number = {6124},
	journaltitle = {Science},
	shortjournal = {Science},
	author = {Monroe, C. and Kim, J.},
	urldate = {2025-03-23},
	date = {2013-03-08},
	langid = {english},
	file = {PDF:/home/taco/Zotero/storage/YQYV89MH/Monroe and Kim - 2013 - Scaling the Ion Trap Quantum Processor.pdf:application/pdf},
}

